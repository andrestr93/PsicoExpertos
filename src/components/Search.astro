---
import Map from "../icons/Map.astro";

import Lens from "../icons/Lens.astro"


---

<form 
  action="/buscar" 
  method="GET"
  class="border rounded-xl bg-white border-border gap-6 pt-5 pb-2 flex flex-col"
  role="search"
  aria-label="Buscar profesional de salud mental"
>
  <div class="flex gap-5 items-center px-5">
    <Lens class="w-6 h-6" aria-hidden="true" />
    <div class="flex flex-col w-full">
      <label for="especialidad" class="sr-only">Especialidad</label>
      <input 
        id="especialidad"
        type="search" 
        name="especialidad" 
        placeholder="Especialidad"
        autocomplete="off"
      />
    </div>
  </div>

  <hr class="w-full" />

  <div class="flex gap-5 px-5">
    <Map class="w-6 h-6" aria-hidden="true" />
    <div class="flex flex-col w-full">
      <label for="ubicacion" class="sr-only">Ubicación</label>
      <input 
        id="ubicacion"
        type="text" 
        name="ubicacion" 
        placeholder="Toda España"
        autocomplete="address-level1"
      />
    </div>
  </div>

  <button 
    type="submit"
    class="bg-cta text-white font-bold rounded-xl py-4 px-3 mx-3"
  >
    Buscar Profesional
  </button>

</form>

  



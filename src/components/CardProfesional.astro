---
import Circle from "../icons/Circle.astro";
import Star from "../icons/Star.astro";
import ListBadge from "./ListBadge.astro";
import profesionales from '../data/profesionales-limpio.json'
import type { Profesional } from "../interfaces/professional.interface";
import { isOpen } from "../utils/functions/getSchedule.function";
const profesionalList: Profesional[] = profesionales
const top5Professional = profesionalList
  .sort((a, b) => {
    // Usamos ?? 0 para que si review_count es null, TypeScript lo trate como un 0
    const reviewsA = a.google_places.review_count ?? 0;
    const reviewsB = b.google_places.review_count ?? 0;

    // Ordenamos de mayor a menor (descendente)
    return reviewsB - reviewsA;
  })
  .slice(0, 5); // Nos quedamos solo con los 5 primeros del array ordenado





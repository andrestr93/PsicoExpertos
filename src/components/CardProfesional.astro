---
import Circle from "../icons/Circle.astro";
import Star from "../icons/Star.astro";
import Badge from "./Badge.astro";
---

<div class="py-10 px-8 border rounded-3xl w-88 ">
    <div class="flex flex-col gap-5">
        <div class=" ml-auto w-fit border rounded-2xl border-transparent flex-end  py-1 px-2 flex items-center gap-2 justify-end bg-green-200">
            <p><Circle class="text-green-400 w-3 h-3"/></p>
            <p>Disponible hoy </p>
    
        </div>
        <p class="text-center text-2xl font-semibold">Dra. Elenea Martinez</p>
        <p class="text-center text-blue-600 font-semibold">Especialista en Ansiedad y estrés</p>
        <div class="flex justify-between">
<Badge   title="Terapia Cognitiva"/>  <Badge title="Adultos"/>
        </div>
        
        <div>
            <hr class="w-full pb-6"/>
            <div class="flex justify-between items-center">
               <div class="flex items-center">  
                
                <Star class="text-yellow-400 "/><span class="font-bold text-xl">4.9</span><span class="font-bold">(124)</span>
            </div> 
               
               <p class="font-bold text-xl">60$/sesion</p>
            </div>
    
        </div>

    </div>
</div>

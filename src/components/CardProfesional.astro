<ul>
  {top5Professional.map((professional) => (
    <li>

<div class=" bg-white border border-gray-200 shadow-xl shadow-gray-200/5   rounded-3xl py-8 px-10 ml-3 mr-3 mt-5 mb-5 flex flex-col gap-5 ">
<div class:list={[
  "ml-auto py-2 px-4 rounded-2xl flex gap-1 items-center", 
  {
    "bg-green-100": isOpen(professional.horario), 
    "bg-red-100": !isOpen(professional.horario) 
  }
]}>
  {isOpen(professional.horario) ? (
    <>
      <span><Circle class="w-3 h-3 text-green-200"/></span>
      <span class="text-xs font-semibold">Disponible</span>
    </>
  ) : (
    <>
      <span><Circle class="w-3 h-3 text-red-400"/></span>
      <span class="text-xs font-semibold">No Disponible</span>
    </>
  )}
</div>

    <div>

    </div>
    
    <p class=" text-2xl font-semibold">{professional.name}</p>
    <p class=" text-blue-600">Especialista en Ansiedad y estrés</p>
       <div>
 <ListBadge tags={professional.tags}/>
    </div>
    <hr/>
    <div class="flex justify-between">
        <div class="flex items-center gap-2">
            <span><Star class="w-5 h-5 text-amber-300"/></span>
            <span class="font-bold text-xl">{professional.google_places.average_rating} <span class="text-sm font-semibold">({professional.google_places.review_count})</span></span>

        </div>
     
    </div>
</div>




    </li>
  ))}
</ul>


---
import Logo from "./Logo.astro";


---

<footer class="bg-container w-full  py-8 px-5 mt-5 ">
    <div class="flex flex-col gap-3">
        <div class="flex gap-3 flex-col">
            <Logo/>
            <p>Conectando salud mental y personas en cada rincón de España de forma profesional segura y humana</p>
        </div>
        <div class="flex justify-between gap-5 ">
            <div class="text-sm flex flex-col gap-3  ">
                <p class="font-bold">Directorio</p>
              
                    <a>Provincias</a>
                    <a>Preguntas Frecuentes</a>
                
            </div>
            <div class="text-sm flex flex-col gap-3 ">
                <p class="font-bold">Empresa</p>
              
                    <a>Sobre Nosotros</a>
                    <a>Contacto</a>
                    <a>Blog</a>
                
            </div>
            <div class="text-sm flex flex-col gap-3 ">
                <p class="font-bold">Legal</p>
              
                    <a>Politica Legal</a>
                    <a>Aviso Legal</a>
                    <a>Cookies</a>
                
            </div>
     
        </div>
        

    </div>
</footer>